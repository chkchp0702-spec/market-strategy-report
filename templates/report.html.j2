<!doctype html>
<html lang="ko"><head><meta charset="utf-8">
<style>{{ css }}</style>
</head><body>
{% set foot = "시황리포트 · " ~ d.date.replace("-", ".") ~ " " ~ d.edition_label ~ " · 전체본" %}

<!-- ===== 1 오늘 한 눈에 ===== -->
<section class="page">
 <div class="hd"><h1 style="word-break:keep-all;flex-shrink:0;margin-right:12px">오늘 <span style="white-space:nowrap">한 눈에</span></h1><div class="d">시황리포트 · <b>{{ d.date.replace("-", ".") }} ({{ d.weekday }}) {{ d.edition_label }}</b> · {{ d.basis }}</div></div>

 {% set GN = d.yesterday_grades | selectattr("cls", "equalto", "no") | list %}
 {% if GN | length >= 2 %}
 <div class="grade">
 {% for g in d.yesterday_grades %}
  <div class="g {{ g.cls }}"><b>{{ g.title }}</b><span class="mark">{{ g.mark }}</span> {{ g.text }}</div>
 {% endfor %}
 </div>
 {% else %}
 <div class="note" style="margin:-2px 0 7px;font-size:8pt">어제 예고 채점 <b>{{ d.yesterday_grades | selectattr("cls", "equalto", "ok") | list | length }}/{{ d.yesterday_grades | length }}</b> —
 {% for g in d.yesterday_grades %}{{ g.mark }} {{ g.title }}{{ ' · ' if not loop.last }}{% endfor %} <span class="src">(자세히는 5쪽 성적표)</span></div>
 {% endif %}

 <div class="one"><div class="k">오늘의 한 줄</div><p>{{ d.one_liner | safe }}</p>
 {% if d.kick %}<div class="kick">{% if d.kick.none %}<b>⚡ 킥</b> 오늘은 킥 없음 — {{ d.kick.why | safe }}{% else %}<b>⚡ 킥</b> {{ d.kick.title | safe }} <span class="so">→ {{ d.kick.so | safe }}</span>{% endif %}</div>{% endif %}</div>

 {% for row in [d.kpis[:4], d.kpis[4:8]] %}
 <div class="g4" {% if not loop.first %}style="margin-top:8px"{% endif %}>
 {% for k in row %}
  <div class="kpi {{ k.cls }}"><div class="l">{{ k.label }}</div><div class="v" {% if k.small %}style="font-size:15pt"{% endif %}>{{ k.value }}</div><div class="c {{ k.change_cls or '' }}">{{ k.change }}</div><div class="s">그래서? {{ k.so }}</div><div class="src">{{ k.src }}</div></div>
 {% endfor %}
 </div>
 {% endfor %}

 <div class="g2" style="margin-top:7px">
  <div class="box"><h3>오늘 내 포트폴리오</h3>
   <div style="margin:3px 0 7px">{% for b in d.decision.badges %}<span class="badge {{ 'chg' if not loop.first }}" {% if not loop.first %}style="font-size:10.5pt;margin-left:6px"{% endif %}>{{ b }}</span>{% endfor %}</div>
   <ul class="b">{% for r in d.decision.reasons %}<li>{{ r | safe }}</li>{% endfor %}</ul>
  </div>
  <div class="box cream"><h3>체크할 것 3개</h3>
   <ul class="b">{% for c in d.checks %}<li>{{ c | safe }}</li>{% endfor %}</ul>
  </div>
 </div>
 <div class="foot"><span>{{ foot }}</span><span>1 / 7</span></div>
</section>

<!-- ===== 2 🎯 오늘의 집중 (돈의 길 → 담는 법 → 행동, 10/7) ===== -->
{% set S = sec or {} %}{% set L = d.leaders or {} %}{% set FO = focus or {} %}{% set FW = (d.focus or {}).why or {} %}
{% macro pc(v) %}{% if v is none %}–{% else %}<span class="{{ 'up' if v >= 0 else 'dn' }}">{{ '%+.1f' % v }}%</span>{% endif %}{% endmacro %}
{% macro actg(a) %}<span class="tag {{ 'r' if a == '추격 금지' else ('o' if a == '눌림 대기' else ('g' if '★' in a else 'x')) }}">{{ a }}</span>{% endmacro %}
<section class="page fz">
 <style>.fz .g2 table td,.fz .g2 table th{padding:1px 4px!important;font-size:8.1pt;line-height:1.35}.fz .fc td{font-size:8pt;line-height:1.4;padding:3px 5px}.fz .etf{font-size:8.3pt;line-height:1.55}.fz ul.b li{font-size:8.6pt;line-height:1.4;margin:1px 0}</style>
 <div class="hd"><h1>🎯 오늘의 집중</h1><div class="d">돈의 길 → 담는 법 → 오늘의 행동 · {{ S.asof|default('') }} 종가 · 숫자는 자동 계산(Yahoo·나침반), 이유는 기사</div></div>
 <div class="one" style="margin-bottom:8px"><div class="k">오늘 돈이 몰리는 곳</div>
  <p>{{ (L.title or (S.notes[0] if S.notes else "자료 없음")) | safe }}</p>
  {% if L.so %}<div class="kick"><b>🎯 그래서</b> {{ L.so | safe }}</div>{% endif %}
 </div>
 <div class="box pale" style="margin-bottom:8px;padding:7px 10px"><h3 style="margin-bottom:3px">① 돈의 길 — 5개 시장 (1주 지수 + 1달 + 오른 종목 비율)</h3>
  <table class="fc"><tr>{% for c in (FO.countries or []) %}<td style="width:20%;vertical-align:top;{{ 'background:#fff3dc;' if loop.first else '' }}">
   <b>{{ c.flag }} {{ c.name }}</b>{% if c.label %} <span class="tag {{ 'r' if loop.first else 'b' }}">{{ c.label }}</span>{% endif %}<br>
   <span class="src">{{ c.ix }} 1주 </span>{{ pc(c.chg5) }} <span class="src">1달</span> {{ pc(c.chg20) }}<br>
   <span class="src">{{ c.regime }} · 오른 종목 {{ c.breadth10 }}%</span>
   {% for h in (c.hot or [])[:1] %}<div class="src" style="color:#334">▲ <b>{{ h.name }}</b> {{ pc(h.r1) }}{% if h.lead %} — {{ h.lead[0].n }}{% endif %}</div>{% endfor %}
  </td>{% endfor %}</tr></table>
 </div>
 <div class="g2">
 {% for t in (FO.themes or [])[:2] %}
  <div class="box{{ ' cream' if loop.first else '' }}"><h3>{{ '②' if loop.first else '③' }} {{ t.name }} <span class="src">{{ t.sym }}</span>{% if t.streak and t.streak >= 3 %} <span class="tag r">🔥{{ t.streak }}일</span>{% endif %}</h3>
   {% if t.stage %}<div style="margin:1px 0 3px"><span class="tag {{ t.stage.c }}">{{ {'초입':'🌱','주도':'🚀','과열':'🔥','꺾임':'🍂'}[t.stage.s] }} {{ t.stage.s }}</span> <b style="font-size:8.6pt">{{ t.stage.do }}</b></div>{% endif %}
   <div style="font-size:8.6pt">5일 {{ pc(t.r5) }} · 20일 {{ pc(t.r20) }} · S&amp;P 대비 20일 {{ '%+.1f' % t.rs20 if t.rs20 is not none else '–' }}%p</div>
   {% if t.flow %}{% set L2 = t.flow.rs %}{% set mn = L2|min %}{% set mx = L2|max %}{% set rg = (mx - mn) if mx > mn else 1 %}
   <div style="display:flex;align-items:center;gap:6px;font-size:8pt;margin-top:2px"><svg width="70" height="18" viewBox="0 0 96 22" preserveAspectRatio="none"><polyline fill="none" stroke="{{ '#d64545' if L2[-1] >= 0 else '#2f6fd6' }}" stroke-width="1.6" points="{% for v in L2 %}{{ (loop.index0 * 95 / (L2|length - 1))|round(1) }},{{ (20 - (v - mn) / rg * 18)|round(1) }} {% endfor %}"/></svg>
    <span style="white-space:nowrap">💧 <b>{{ t.flow.lab }}</b> · 대비 {{ pc(L2[-1]) }} · 거래 {{ t.flow.dv }}배</span></div>{% endif %}
   {% if t.lag %}<div class="note" style="color:#334">🔗 {{ t.lag.txt }}{% if t.lag.today %} — <b>{{ t.lag.today }}</b>{% endif %}</div>{% endif %}
   <div class="note" style="margin:2px 0 4px;color:#334;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">{{ (FW[t.sym] if FW[t.sym] else (L.why if loop.first and L.why else t.why_auto)) | safe }}</div>
   <div class="etf"><b style="color:var(--navy)">ETF</b> 🇺🇸 <b>{{ t.sym }}</b> {{ pc(t.etf_us.r5) }} {{ actg(t.etf_us.act) }}
   {% for x in t.etf_kr[:2] %}<br>🇰🇷 <b>{{ x.name }}</b> {{ pc(x.r5) if x.r5 is defined else '' }} {{ actg(x.act) }}{% endfor %}</div>
   <div style="font-size:8.3pt;font-weight:800;color:var(--navy);margin-top:3px">종목 <span class="src">★ = 우리 컵·갭·매집에도 걸림 · 5일</span></div>
   <table>
   {% for x in (t.us[:4] + t.kr[:4]) %}<tr><td class="nw">{{ '🇺🇸' if x.mkt == 'US' else '🇰🇷' }} {{ x.name[:10] }}{% if x.star %} <b style="color:#c47a00">★{{ x.star }}</b>{% endif %}</td><td>{{ pc(x.r5) }}</td><td class="src nw" style="margin:0">{% if x.pos %}{{ x.pos.k }} {{ '%+.1f' % x.pos.d if x.pos.d is not none else '' }}%{% endif %}</td><td>{{ actg(x.act) }}</td></tr>{% endfor %}
   </table>
   {% if t.supply %}<div class="note" style="margin-top:3px;color:#334">🏦 한국 연결주 5일 수급(주): 외국인 <b class="{{ 'up' if t.supply.frg >= 0 else 'dn' }}">{{ '{:+,}'.format(t.supply.frg) }}</b> · 기관 <b class="{{ 'up' if t.supply.org >= 0 else 'dn' }}">{{ '{:+,}'.format(t.supply.org) }}</b> ({{ t.supply.n }}종목)</div>{% endif %}
   {% if t.stop %}<div class="note" style="margin-top:3px">⛔ <b>이게 깨지면</b> {{ t.stop }}</div>{% endif %}
  </div>
 {% endfor %}
 </div>
 {% set SC = FO.score or {} %}
 <div class="box pale" style="margin-top:8px"><h3>🧊 돈이 빠지는 곳 · 🇰🇷 한국 연결</h3>
  <ul class="b">
  {% for a in (FO.avoid or [])[:2] %}<li>🧊 <b>{{ a.name }}</b> ({{ a.sym }}) 5일 {{ pc(a.r5) }} · 20일 {{ pc(a.r20) }}</li>{% endfor %}
  {% for k in (L.korea or [])[:1] %}<li style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{{ k | safe }}</li>{% endfor %}
  </ul></div>
 {% if SC.bad or (d.edition == 'WK' and SC.week) %}
 <div class="box" style="margin-top:8px;border-color:#f0c6c2;background:#fdf1ef"><h3>{% if SC.bad %}⚠️ 집중 성적이 나빠요 — 최근 5번 중 3번 이상 S&amp;P에 짐{% else %}🗓️ 이번 주 집중 회고 — 고른 테마 5거래일 뒤 vs S&amp;P{% endif %}</h3>
  <table>{% for e in SC.week[:4] %}<tr><td>{{ e.asof[5:] }}</td><td><b>{{ e.name }}</b></td><td>{{ pc(e.res) }}</td><td>S&amp;P {{ pc(e.spy_res) }}</td><td class="src">{{ e.lesson }}</td></tr>{% endfor %}</table></div>
 {% else %}
 <div class="note" style="margin-top:5px">📒 집중 성적 {% if SC.n %}<b>{{ SC.hit }}/{{ SC.n }}</b> (5거래일 뒤 S&amp;P 대비 평균 {{ pc(SC.avg_ex) }}){% else %}— 10/7부터 기록, 5거래일 뒤부터 채점{% endif %}</div>
 {% endif %}
 <div class="note" style="margin-top:4px">단계 🌱초입=모아가기 · 🚀주도=눌림 매수 · 🔥과열=추격 금지 · 🍂꺾임=끝났나? / ★관심=테마+차트 자리 · 눌림 대기=5일 +15%↑ · 추격 금지=하루 +8%↑ · 자리=컵 기준가·갭 시가·20일선까지. 매수 권유 아님.</div>
 <div class="foot"><span>{{ foot }}</span><span>2 / 7</span></div>
</section>

<!-- ===== 2 무슨 일이 있었나 ===== -->
<section class="page">
 <div class="hd"><h1>무슨 일이 있었나</h1><div class="d">핵심 이야기 · 고정 그림 2개 · 반대 의견</div></div>
 {% if d.kick and not d.kick.none and charts.kick_svg %}
 <div class="box onepic"><h3>⚡ 오늘의 한 장 — {{ d.kick.title | safe }}</h3><div class="op-g"><div class="op-c">{{ charts.kick_svg | safe }}</div><div class="op-t">{{ d.kick.why | safe }}<div class="op-so">→ {{ d.kick.so | safe }}</div></div></div></div>
 {% endif %}
 <div class="h2">{{ d.story.title }}</div>
 <p class="lead">{{ d.story.lead | safe }}</p>

 <div class="g2">
  <div class="box"><h3>고정 그림 ① 외국인 코스피 순매수 (억원) — 장부 {{ charts.foreign_n }}일치</h3>{{ charts.foreign_svg | safe }}<div class="note">{{ charts.foreign_cap }}</div></div>
  <div class="box"><h3>고정 그림 ② 미국 10년 국채금리 (%) — 장부 {{ charts.us10y_n }}일치</h3>{{ charts.us10y_svg | safe }}<div class="note">{{ charts.us10y_cap }}</div></div>
 </div>

 <div class="g2" style="margin-top:9px">
  <div class="box"><h3>{{ d.story.korea_title }}</h3><div class="story">{% for p in d.story.korea %}<p>{{ p | safe }}</p>{% endfor %}</div></div>
  <div class="box pale"><h3>반대 의견 — 같은 크기로</h3><ul class="b">{% for c in d.counter %}<li>{{ c | safe }}</li>{% endfor %}</ul></div>
 </div>
 <div class="foot"><span>{{ foot }}</span><span>3 / 7</span></div>
</section>

<!-- ===== 3 전략가 패널 ===== -->
<section class="page">
 <div class="hd"><h1>전략가 패널 {{ panel_rows | length }}명</h1><div class="d">오늘 새 발언 <b>{{ d.panel_new_count }}명 / {{ panel_rows | length }}명</b> · 10/2부터 집계 · 빈칸은 발언 없음</div></div>
 <table class="panel">
  <tr><th style="width:18px">#</th><th style="width:118px">누구</th><th>① 금리 꼭대기인가</th><th>② AI 이익 계속되나</th><th>③ 한국 살 때인가</th><th style="width:56px">오늘</th><th style="width:34px">누적</th></tr>
 {% for sec in panel_groups %}
  <tr class="sec"><td colspan="7">{{ sec.title }}</td></tr>
  {% for r in sec.rows %}
  <tr><td>{{ r.n }}</td><td>{% if r.is_new or r.verdict %}<b>{{ r.name }}</b>{% else %}{{ r.name }}{% endif %}</td>
   {% for q in ['q1','q2','q3'] %}<td class="{{ '' if r.is_new else 'g' }}">{% if r[q] %}{{ r[q] }}{% if r.qdate %} ({{ r.qdate }}){% endif %}{% else %}—{% endif %}</td>{% endfor %}
   <td>{% if r.verdict == 'win' %}<span class="pt g">득점</span> {% elif r.verdict == 'loss' %}<span class="pt r">실점</span> {% endif %}{{ r.today | replace('득점 — ', '') | replace('실점 — ', '') | replace('득점', '') | replace('실점', '') }}</td>
   <td>{{ r.cum }}</td></tr>
  {% endfor %}
 {% endfor %}
 </table>
 <div class="sum">{% for s in d.panel_summary %}<div class="c">{{ s | safe }}</div>{% endfor %}</div>
 <div class="note" style="margin-top:3px;font-size:7pt">출처: {{ d.panel_sources }}</div>
 <div class="foot"><span>{{ foot }}</span><span>4 / 7</span></div>
</section>

<!-- ===== 4 대결 · 발언 · 성적표 ===== -->
<section class="page">
 <div class="hd"><h1>오늘의 대결 · 발언 · 내 성적표</h1><div class="d">1:1 대결 1 · 발언 · 패널 밖 판정 · 성적표</div></div>
 <div class="box" style="margin-bottom:9px"><h3>오늘의 1:1 대결 — {{ d.duel.title }}</h3>
  <div class="vsbox">
   <div><b style="color:var(--dn)">{{ d.duel.left_name }}</b><br>{{ d.duel.left_text }}<br><span class="note">판정 숫자: {{ d.duel.left_rule }}</span></div>
   <div class="m">vs</div>
   <div><b style="color:var(--up)">{{ d.duel.right_name }}</b><br>{{ d.duel.right_text }}<br><span class="note">판정 숫자: {{ d.duel.right_rule }}</span></div>
  </div>
  <div style="background:var(--cream);border-radius:6px;padding:5px 9px;margin-top:6px;font-size:9.2pt">{{ d.duel.verdict | safe }}</div>
 </div>
 <div class="g2">
  <div>{% for q in d.quotes[:2] %}<div class="q {{ q.cls }}"><div class="who">{{ q.who }}</div><div class="said">{{ q.said }}</div><div class="so">{{ q.so | safe }}</div></div>{% endfor %}</div>
  <div>{% for q in d.quotes[2:4] %}<div class="q {{ q.cls }}"><div class="who">{{ q.who }}</div><div class="said">{{ q.said }}</div><div class="so">{{ q.so | safe }}</div></div>{% endfor %}</div>
 </div>
 <div class="g2" style="margin-top:9px">
  <div class="box"><h3>패널 밖 진행 중 판정</h3>
   <table><tr><th>누가</th><th>주장</th><th>오늘</th><th style="width:40px">누적</th></tr>
   {% for o in outside_rows %}<tr><td {% if o.name == '나' %}style="background:var(--cream)"{% endif %}><b>{{ o.name }}</b></td><td {% if o.name == '나' %}style="background:var(--cream)"{% endif %}>{{ o.claim }}</td><td {% if o.name == '나' %}style="background:var(--cream)"{% endif %}>{% if o.verdict == 'win' %}<span class="pt g">득점</span> {% elif o.verdict == 'loss' %}<span class="pt r">실점</span> {% endif %}{{ o.today | replace('득점 — ', '') | replace('실점 — ', '') }}</td><td {% if o.name == '나' %}style="background:var(--cream)"{% endif %}>{{ o.win }}:{{ o.loss }}</td></tr>{% endfor %}
   </table>
  </div>
  <div class="box"><h3>내 성적표 — 어제 쓴 것 채점</h3>
   <table><tr><th>어제 쓴 것</th><th>결과</th><th style="width:42px">판정</th></tr>
   {% for s in d.scorecard_today %}<tr><td>{{ s.wrote }}</td><td>{{ s.result }}</td><td><span class="pt {{ {'맞음':'g','틀림':'r'}.get(s.verdict,'n') }}">{{ s.verdict }}</span></td></tr>{% endfor %}
   </table>
   <div class="note" style="margin-top:3px">누적 (10/2~): {{ scorecard_total }}{% if cal.n %} · {{ cal.line }}{% endif %}</div>
  </div>
 </div>
 <div class="foot"><span>{{ foot }}</span><span>5 / 7</span></div>
</section>

<!-- ===== 5 내 포트폴리오 ===== -->
<section class="page">
 <div class="hd"><h1>내 포트폴리오 — 배분과 실제 종목</h1><div class="d">{{ d.decision.badges | join(' · ') }}</div></div>
 <div class="box"><h3>배분표</h3>
  <table class="altb" style="font-size:7.5pt">
   <tr><th style="width:36px">비중</th><th style="width:72px">무엇</th><th>실제로 담는 것</th><th>어제 본 것</th><th style="width:62px">판정</th><th style="width:132px">바꿀 조건</th></tr>
   {% for a in alloc_rows %}<tr><td><b>{{ a.pct }}%</b></td><td>{{ a.name }}</td><td>{{ a.instruments }}</td><td>{{ a.seen }}</td><td class="{{ a.verdict_cls }}">{{ a.verdict }}</td><td>{{ a.rule }}</td></tr>{% endfor %}
  </table>
  <div class="note" style="margin-top:3px">{{ d.allocation_note }}</div>
  {% if kick_alloc %}<div style="margin-top:2px;background:#fff1f0;border-left:3px solid #e0524b;border-radius:4px;padding:2px 6px;font-size:7.3pt;line-height:1.25">
   <b>⚡ 킥 포함 배분</b> — 현금 {{ kick_alloc.cash }}→{{ kick_alloc.cash_k }}% · 킥 슬리브 {{ kick_alloc.kw }}%{% if kick_alloc.open %} = {% for o in kick_alloc.open %}{{ o.name }} {{ o.w }}%({{ '%+.1f' % o.r if o.r is not none else '–' }}%){% if not loop.last %} · {% endif %}{% endfor %}{% endif %}
   · 누적 💼 기본 {{ '%+.2f' % kick_alloc.stat.base }}% · ⚡ 킥 {{ '%+.2f' % kick_alloc.stat.kick }}% · S&P {{ '%+.2f' % kick_alloc.stat.spy }}%</div>{% endif %}
 </div>
 <div class="g2" style="margin-top:7px">
  <div class="box"><h3>경우의 수 — 확률</h3>
   {% for s in led.scenarios %}
   <div class="alloc"><span>{{ s.pct }}%</span><div class="t"><div class="f" style="width:{{ s.pct }}%;background:{{ s.color }}"></div></div><span class="n">{{ s.code }} {{ d.scenario_delta.get(s.code, '') }}</span></div>
   <div style="font-size:8.4pt;color:#3d4756;margin:-2px 0 4px 66px">{{ s.label }} — {{ d.scenario_desc.get(s.code, '') }}</div>
   {% endfor %}
   <div style="background:var(--cream);border-radius:6px;padding:4px 8px;margin-top:5px;font-size:8.6pt">{{ d.scenario_rule_note | safe }}</div>
  </div>
  <div>
   <div class="box" style="margin-bottom:7px"><h3>세 시장이 각각 무슨 말을 하나</h3>
    <table><tr><th>시장</th><th>어제 한 말</th><th style="width:64px">방향</th></tr>
    {% for t in d.triangle %}<tr><td><b>{{ t.market }}</b></td><td>{{ t.said }}</td><td class="{{ t.dir_cls }}">{{ t.dir }}</td></tr>{% endfor %}</table>
    <div style="background:var(--cream);border-radius:6px;padding:4px 8px;margin-top:5px;font-size:8.6pt">{{ d.triangle_note | safe }}</div>
   </div>
   <div class="box"><h3>축 후보</h3>
    <table><tr><th>후보</th><th>어제 신호</th><th>승격 조건</th></tr>
    {% for c in led.candidates if d.candidates_signal.get(c.name) %}<tr><td><b>{{ c.name }}</b> <span class="tag {{ c.tag_cls }}">{{ c.tag }}</span></td><td>{{ d.candidates_signal.get(c.name, '') }}</td><td>{{ c.cond }}</td></tr>{% endfor %}
    </table>
   </div>
  </div>
 </div>
 <div class="foot"><span>{{ foot }}</span><span>6 / 7</span></div>
</section>

<!-- ===== 6 앞으로 볼 것 ===== -->
<section class="page">
 <div class="hd"><h1>앞으로 볼 것</h1><div class="d">일정 · 틀렸다는 신호 · 점검표</div></div>
 <div class="g2">
  <div class="box"><h3>일정 (한국시간)</h3>
   <table><tr><th style="width:76px">언제</th><th>무엇</th><th>결과에 따라</th></tr>
   {% for s in d.schedule[:6] %}<tr><td class="nw"><b>{{ s.when }}</b></td><td>{{ s.what | safe }}</td><td>{{ s.then }}</td></tr>{% endfor %}</table>
  </div>
  <div class="box"><h3>이렇게 되면 내 판단이 틀린 것</h3>
   <table><tr><th>내 주장</th><th>틀렸다는 신호</th><th style="width:62px">거리</th></tr>
   {% for f in d.falsify %}<tr><td><b>{{ f.claim }}</b></td><td>{{ f.signal }}</td><td class="nw">{{ f.dist }}</td></tr>{% endfor %}</table>
  </div>
 </div>
 <div class="box" style="margin-top:7px"><h3>점검표 — 비중 바꾸는 조건</h3>
  <table style="font-size:8pt"><tr><th>조건</th><th>지금 수치</th><th style="width:58px">상태</th><th>발동하면</th></tr>
  {% for c in led.conditions %}<tr><td>{{ c.cond }}</td><td>{% if c.count is defined %}<b>{{ c.count }}/{{ c.of }}</b> · {% endif %}{{ c.now }}</td><td class="{{ 'up' if c.state == '발동' else '' }}">{{ c.state }}</td><td>{{ c.then }}</td></tr>{% endfor %}
  </table>
 </div>
 <div class="box" style="margin-top:7px"><h3>못 찾은 것 · 출처 · 유의사항</h3>
  <div class="note" style="font-size:7.1pt;line-height:1.4"><b>못 찾은 것:</b> {{ d.missing }}<br><b>출처:</b> {{ d.sources }} · 장부: ledger/ledger.json<br><b>유의사항</b> — 정보 제공 목적이며 투자자문이 아님. 비중·확률·조건·패널 채점은 모두 작성자의 판단이며 객관적 기준이 아님. 종목·ETF는 지수 대용의 예시이며 매수 추천이 아님. 출처별 수치가 다른 항목은 범위로 표기. 패널 "침묵"은 발언을 찾지 못한 것이지 입장이 없다는 뜻이 아님. 해외 자산은 환율에 따라 손익이 달라짐. 과거 성과는 미래 수익을 보장하지 않으며 원금 손실이 발생할 수 있음. 투자 판단과 결과의 책임은 투자자 본인에게 있음.</div>
 </div>
 <div class="foot"><span>{{ foot }}</span><span>7 / 7</span></div>
</section>
</body></html>
